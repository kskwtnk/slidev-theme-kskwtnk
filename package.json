{
  "name": "slidev-theme-kskwtnk",
  "version": "0.0.0",
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@slidev/types": "^52.20.1",
    "beautiful-mermaid": "^1.1.3"
  },
  "devDependencies": {
    "@slidev/cli": "^52.20.1",
    "markdown-it": "^14.3.3",
    "prettier": "^3.8.1",
    "prettier-plugin-slidev": "^1.0.5"
  },
  "//": "Learn more: https://sli.dev/guide/write-theme.html",
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "canvasWidth": 960,
      "fonts": {
        "sans": "Shorai Sans StdN Var",
        "mono": "Fira Code"
      },
      "transition": "kskwtnk-forward | kskwtnk-backward"
    }
  }
}
